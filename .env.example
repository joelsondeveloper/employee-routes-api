# Copy to .env for local development. Production values live in Vercel; never commit real ones.
NODE_ENV=development
PORT=3000

# Without DATABASE_URL the API serves only /health and the guest playground.
# Local database: docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_routes
DATABASE_POOL_MAX=10
# PEM of the CA that signs the database certificate (Supabase: Database settings > SSL).
# When set, TLS is verified in code and any sslmode in DATABASE_URL is ignored.
DATABASE_CA_CERT=

GOOGLE_CLIENT_ID=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
LOCATIONIQ_API_KEY=
# Only needed when the frontend is served from another origin.
FRONTEND_ORIGIN=
